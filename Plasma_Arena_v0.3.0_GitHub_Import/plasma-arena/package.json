{
  "name": "spaceaces77-plasma-arena",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "SpaceAces77 Plasma Arena v0.1 — standalone arcade prototype. Not Plasma Sea.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199",
    "build": "vite build && node scripts/inline-dist.mjs",
